{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "kollection-poster-renderer-v2",
  "main": "src/index.js",
  "compatibility_date": "2026-09-09",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "routes": [
    {
      "pattern": "poster-renderer.kollection.tv",
      "custom_domain": true
    }
  ],
  "containers": [
    {
      "class_name": "PosterRenderer",
      "image": "./Dockerfile",
      "max_instances": 2,
      "instance_type": "basic"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "POSTER_RENDERER",
        "class_name": "PosterRenderer"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["PosterRenderer"]
    }
  ]
}
