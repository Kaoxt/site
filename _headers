# The Kollection — versioned shared assets
# Shared asset URLs are versioned together in page entrypoints/components.js.
# A short browser cache avoids repeat navigation round trips; API responses stay no-store.

/shared.css
  Cache-Control: public, max-age=300

/components.js
  Cache-Control: public, max-age=300

/nav.html
  Cache-Control: public, max-age=300

/nav
  Cache-Control: public, max-age=300

/footer.html
  Cache-Control: public, max-age=300

/footer
  Cache-Control: public, max-age=300

/favicon.ico
  Cache-Control: no-cache, max-age=0, must-revalidate

/admin-file-manager.html
  Cache-Control: no-cache, max-age=0, must-revalidate

/admin/file-manager.js
  Cache-Control: no-cache, max-age=0, must-revalidate

/admin/file-manager.css
  Cache-Control: no-cache, max-age=0, must-revalidate

# Account navigation helpers use the same short public-asset cache.
/admin.html
  Cache-Control: no-cache, max-age=0, must-revalidate

/admin/admin-pages.css
  Cache-Control: no-cache, max-age=0, must-revalidate

/nuvio-auth/nav-account.js
  Cache-Control: public, max-age=300

/nuvio-auth/nav-account.css
  Cache-Control: public, max-age=300

/nuvio-auth/admin-nav.js
  Cache-Control: public, max-age=300

/nuvio-auth/admin-nav.css
  Cache-Control: public, max-age=300

# Posters is under active development; always revalidate the configurator assets.
/posters.html
  Cache-Control: no-cache, max-age=0, must-revalidate

/posters/*
  Cache-Control: no-cache, max-age=0, must-revalidate

# Shared helpers contain only public client code/styles, never session responses.
/nuvio-auth/nuvio-auth.js
  Cache-Control: public, max-age=300

/nuvio-auth/nav-login-redirect.js
  Cache-Control: public, max-age=300

/nuvio-auth/account-link.js
  Cache-Control: public, max-age=300

/nav-interaction.css
  Cache-Control: public, max-age=300

/secondary-pages.css
  Cache-Control: public, max-age=300

# Browser defenses for static site pages and assets.
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: no-referrer
  Content-Security-Policy: frame-ancestors 'none'; base-uri 'self'; object-src 'none'

# The forum has only same-origin external scripts; disallow injected scripts.
/discussions
  Content-Security-Policy: script-src 'self'; script-src-attr 'none'
/discussions.html
  Content-Security-Policy: script-src 'self'; script-src-attr 'none'
